# Copy to .env for the live smoke script (npm run smoke -- <vendor>).
# The CLI itself never reads this file: MCP clients pass these variables in
# the server's environment. Never commit a filled-in copy.

# serper: the API key from your serper.dev dashboard
SERPER_API_KEY=

# devto: dev.to Settings -> Extensions -> DEV Community API Keys
DEVTO_APIKEY=

# bluesky: your handle and an app password (never the account password)
BLUESKY_HANDLE=
BLUESKY_APPPASSWORD=

# mastodon: your server's address (https://mastodon.social) and the access
# token of an application from Preferences -> Development on that server
MASTODON_INSTANCEURL=
MASTODON_TOKEN=

# pinterest: a current OAuth access token of your own Pinterest app
# (developers.pinterest.com -> My apps)
PINTEREST_ACCESS_TOKEN=

# tumblr: a current OAuth 2 access token of your own Tumblr app
# (tumblr.com/oauth/apps); pick its blogs with CONNECTOR_ACCOUNTS {"blogs":["t:..."]}
TUMBLR_ACCESS_TOKEN=

# Optional account lock for account-scoped tools, e.g. {"pages":["123"]}
# CONNECTOR_ACCOUNTS=
