# Copy to .env for the live smoke script (npm run smoke -- <vendor>).
# The CLI itself never reads this file: MCP clients pass these variables in
# the server's environment. Never commit a filled-in copy. Each connector's
# README (src/vendors/<vendor>/README.md) says step by step where every value
# comes from and how to revoke it. Fill in only the connectors you test.

# adapty: the app's secret API key (Adapty Dashboard -> App settings -> General -> API keys)
ADAPTY_APIKEY=

# adjust: Account settings -> My profile -> API Token
ADJUST_USERAPITOKEN=

# apollo: an API key, or a master API key (Settings -> Integrations -> API)
APOLLO_APIKEY=
APOLLO_MASTERAPIKEY=

# apple-appstore: an App Store Connect team API key: key ID, issuer ID and the
# text of the .p8 file (or its base64)
APPLE_APPSTORE_KEYID=
APPLE_APPSTORE_ISSUERID=
APPLE_APPSTORE_PRIVATEKEY=

# beehiiv: Settings -> Workspace Settings -> API; the publication ID is optional
BEEHIIV_APIKEY=
BEEHIIV_PUBLICATIONID=

# blogger: a current OAuth access token of your own Google OAuth client
BLOGGER_ACCESS_TOKEN=

# bluesky: your handle and an app password (never the account password)
BLUESKY_HANDLE=
BLUESKY_APPPASSWORD=

# brevo: SMTP & API -> API Keys
BREVO_APIKEY=

# calendarific: the API key on your account dashboard
CALENDARIFIC_APIKEY=

# devto: dev.to Settings -> Extensions -> DEV Community API Keys
DEVTO_APIKEY=

# facebook-pages: a sign-in token of your own Meta app (with its app secret
# proof when the app requires one), or a system user token
FACEBOOK_PAGES_ACCESS_TOKEN=
FACEBOOK_PAGES_APPSECRET_PROOF=
FACEBOOK_PAGES_SYSTEMUSERTOKEN=
FACEBOOK_PAGES_ACCESSTOKEN=

# firebase: a project's service account key JSON, or a JSON list of projects
FIREBASE_ACCOUNTS=

# ga4: a current OAuth access token of your own Google OAuth client
GA4_ACCESS_TOKEN=

# gmail: a current OAuth access token of your own Google OAuth client
GMAIL_ACCESS_TOKEN=

# google-ads: a current OAuth access token of your own Google OAuth client; a
# manager account ID when you reach accounts through one
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_MANAGERCUSTOMERID=
GOOGLE_ADS_DEVELOPERTOKEN=

# google-business: a current OAuth access token of your own Google OAuth client
GOOGLE_BUSINESS_ACCESS_TOKEN=

# google-calendar: a service account key JSON (or its base64) and a calendar
# shared with it; time zone and slot length are optional
GOOGLE_CALENDAR_SERVICEACCOUNTJSON=
GOOGLE_CALENDAR_CALENDARID=
GOOGLE_CALENDAR_TIMEZONE=
GOOGLE_CALENDAR_SLOTDURATIONMINUTES=

# google-drive: a service account key JSON (or its base64); share the folders with it
GOOGLE_DRIVE_SERVICEACCOUNTJSON=

# google-merchant-center: a current OAuth access token of your own Google OAuth client
GOOGLE_MERCHANT_CENTER_ACCESS_TOKEN=

# google-play: a service account key JSON (or its base64), invited in Play Console
GOOGLE_PLAY_SERVICEACCOUNTJSON=

# google-search-console: a current OAuth access token of your own Google OAuth client
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=

# hashnode: Account Settings -> Developer; the blog's host, such as yourname.hashnode.dev
HASHNODE_TOKEN=
HASHNODE_PUBLICATIONHOST=

# instagram: an Instagram Login token of your own Meta app (with the account ID
# and username), or a system user token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNTID=
INSTAGRAM_IGUSERNAME=
INSTAGRAM_SYSTEMUSERTOKEN=

# kaggle: your username and a token from Settings -> API
KAGGLE_USERNAME=
KAGGLE_APITOKEN=

# keepa: the private API access key on keepa.com/api
KEEPA_APIKEY=

# linkedin: a current OAuth access token of your own LinkedIn app; a Page ID to post as a Page
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATIONID=
LINKEDIN_LINKEDINNAME=

# mailchimp: an API key, or an access token of your own app with its data center (server)
MAILCHIMP_APIKEY=
MAILCHIMP_ACCESS_TOKEN=
MAILCHIMP_SERVER=

# mastodon: your server's address (https://mastodon.social) and the access
# token of an application from Preferences -> Development on that server
MASTODON_INSTANCEURL=
MASTODON_TOKEN=

# meta-ads: a sign-in token of your own Meta app (with its app secret proof when
# the app requires one), or a system user token; Page mappings are optional
META_ADS_ACCESS_TOKEN=
META_ADS_APPSECRET_PROOF=
META_ADS_SYSTEMUSERTOKEN=
META_ADS_PAGEMAPPINGS=

# notion: an internal connection's API token, or a personal access token
NOTION_TOKEN=

# pinterest: a current OAuth access token of your own Pinterest app
# (developers.pinterest.com -> My apps)
PINTEREST_ACCESS_TOKEN=

# qiita: Settings -> Applications -> Personal access tokens (read_qiita, write_qiita)
QIITA_TOKEN=

# reddit: a current OAuth access token of your own Reddit web app and the
# username of the account that owns the app
REDDIT_ACCESS_TOKEN=
REDDIT_DEVELOPERPROFILEUSERNAME=
REDDIT_REDDITUSERNAME=

# revenuecat: a V2 secret API key (Project settings -> API keys)
REVENUECAT_APIKEY=

# roasit: Account -> API tokens
ROASIT_APITOKEN=

# sendgrid: Settings -> API Keys
SENDGRID_APIKEY=

# serper: the API key from your serper.dev dashboard
SERPER_APIKEY=

# shopify: the store's <shop>.myshopify.com address and an Admin API access token of your own app
SHOPIFY_SHOPDOMAIN=
SHOPIFY_ACCESS_TOKEN=

# threads: a current Threads user token of your own Meta app
THREADS_ACCESS_TOKEN=
THREADS_THREADSUSERID=
THREADS_THREADSUSERNAME=

# tiktok: a current user access token of your own TikTok app
TIKTOK_ACCESS_TOKEN=
TIKTOK_TIKTOKUSERNAME=
TIKTOK_OPENID=

# tumblr: a current OAuth 2 access token of your own Tumblr app
# (tumblr.com/oauth/apps); pick its blogs with CONNECTOR_ACCOUNTS {"blogs":["t:..."]}
TUMBLR_ACCESS_TOKEN=

# twitter: a current OAuth 2.0 user access token of your own X app
TWITTER_ACCESS_TOKEN=
TWITTER_XUSERNAME=

# woocommerce: the store's address and a REST API key (WooCommerce -> Settings -> Advanced -> REST API)
WOOCOMMERCE_STOREURL=
WOOCOMMERCE_CONSUMERKEY=
WOOCOMMERCE_CONSUMERSECRET=

# wordpress: the site's address, the user's login name and an application password
WORDPRESS_URL=
WORDPRESS_USER=
WORDPRESS_APPPASSWORD=

# youtube: a current OAuth access token of your own Google OAuth client
YOUTUBE_ACCESS_TOKEN=

# Optional account lock for account-scoped tools, e.g. {"pages":["123"]}
# CONNECTOR_ACCOUNTS=
