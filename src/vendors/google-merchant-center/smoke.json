{
  "read": { "tool": "list_accounts", "args": {} },
  "write": {
    "tool": "insert_product",
    "args": {
      "account_id": "123456789",
      "data_source": "987654321",
      "offer_id": "connector-smoke-test",
      "content_language": "en",
      "feed_label": "US",
      "product_attributes": {
        "title": "Connector smoke test {{timestamp}}",
